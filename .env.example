# --- datastores ---
DATABASE_URL=postgres://rtb:rtb@postgres:5432/rtbdsp
# The engine belongs to exactly ONE cluster. Python services resolve per-cluster Redis URLs
# from the `clusters` table via redis_client.client_for() (finding M20) and do not use this.
REDIS_URL=redis://redis:6379/0
CLUSTER_ID=1
CLUSTER_NAME=us-east

# --- engine ---
ENGINE_BIND=0.0.0.0:8080
CONFIG_REFRESH_SECS=5
RESERVATION_TTL_MS=5000
MAX_BUDGET_FALLBACK=5

# --- workers ---
TOPUP_INTERVAL_SECS=5
RECLAIM_INTERVAL_SECS=1
RECONCILE_INTERVAL_SECS=30
TOPUP_HEALTH_PORT=8090

# --- services ---
CAMPAIGN_APP_BIND=0.0.0.0:8000
WIN_NOTIFIER_BIND=0.0.0.0:8010
WIN_NOTIFIER_URL=http://win-notifier:8010

# --- demo scale (finding M10: these numbers are what make budgets visibly drain) ---
# Budget is sized as impressions_target x (bid_cpm/1000), and the seeder deliberately
# correlates high CPM with low budget. Independent draws were why "at least one campaign
# exhausts" was flaky by construction.
# Sized from a MEASURED run, not a guess. At rate=200/duration=90 the exchange delivers
# ~2,500 wins across ~100 campaigns. With targets of 20-75 impressions (avg 49) total demand
# was ~4,900 impressions, so the run drained 51% of budget and 30 campaigns reached >=90% --
# but ZERO exhausted, which fails AC-36. Halving the targets puts average demand (~22) below
# delivered wins, so a large fraction exhausts inside the same watchable 90 seconds.
SEED_IMPRESSIONS_MIN=10
SEED_IMPRESSIONS_MAX=35
EXCHANGE_RATE=200
EXCHANGE_DURATION=90
EXCHANGE_WIN_RATE=0.40
EXCHANGE_SILENT_LOSS_PCT=5

# --- monitoring ---
GRAFANA_ADMIN_PASSWORD=rtbdsp

# --- host port publishing ---
# Every service in the stack is published to the host; services still reach each other by
# compose service name, so changing a host port here never breaks intra-stack traffic.
# The datastore defaults avoid 5432/6379 so the demo does not collide with another local
# stack.
POSTGRES_HOST_PORT=55433
REDIS_HOST_PORT=56379
ENGINE_HOST_PORT=8080
CAMPAIGN_APP_HOST_PORT=8000
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
WIN_NOTIFIER_HOST_PORT=8010
TOPUP_WORKER_HOST_PORT=8090
MOCK_EXCHANGE_HOST_PORT=9091
